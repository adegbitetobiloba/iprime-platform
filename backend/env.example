# Copy to .env for local use. On Render set these under Environment. NEVER commit a real .env.

NODE_ENV=development
PORT=3000

# MongoDB Atlas connection string for the iPrime database (its own database, not any other project's)
MONGO_URI=mongodb_connection_string_placeholder

# At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret

# Allowed frontend origins, comma-separated. REQUIRED when NODE_ENV=production.
CORS_ORIGINS=http://localhost:5173

# Optional: auth rate limit per 15 minutes per IP (default 30)
# AUTH_RATE_LIMIT=30

# OTP email - choose ONE provider (if none is set in production, sending fails with a clear error):
# (A) Brevo HTTPS API (works on Render's free plan, which blocks SMTP)
BREVO_API_KEY=
EMAIL_FROM=
# (B) Gmail SMTP (local / paid hosts only)
EMAIL_USER=
EMAIL_PASS=

# Administrators: comma-separated email addresses. An account with one of these addresses becomes an administrator
# once its email is VERIFIED (OTP) and the person logs in. Leave empty for no administrators.
ADMIN_EMAILS=
